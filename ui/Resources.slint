import { ItemStack } from "./Recipe.slint";
import { StandardButton , VerticalBox, ScrollView, HorizontalBox, LineEdit, StandardTableView} from "std-widgets.slint";

export component Resources inherits Dialog {
    in property <[[StandardListViewItem]]> resources <=> table.rows;
    title: "Resources";
    min-height: 240px;
    min-width: 360px;

    callback search-edited <=> search-box.edited;

    VerticalLayout {
        search-box := LineEdit {
            placeholder-text: "Search resources...";
        }
        table := StandardTableView {
            columns: [ { title: "Item" }, { title: "Count" } ];
        }
    }
    StandardButton { kind: close; }
}
